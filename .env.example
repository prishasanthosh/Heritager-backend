# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/heritage-heart

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Leave COOKIE_DOMAIN empty unless using a custom API subdomain. Never set it
# to a frontend-only domain when the backend is hosted directly on onrender.com.
COOKIE_DOMAIN=
# Production cross-site Render cookies require "none". Use "lax" only when the
# frontend and API share the indianheritager.org site (for example api.indianheritager.org).
COOKIE_SAME_SITE=none

# First admin bootstrap — anyone who registers with this email becomes an admin.
# Change this to your own email, register once through the shop/admin login form, then remove or change it.
ADMIN_BOOTSTRAP_EMAIL=santhosh@indianheritager.org

# CORS — comma separated list of allowed frontend origins. The production admin
# origins https://admin.indianheritager.org and https://books.indianheritager.org are always allowed.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://192.168.102.1:8080

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP email delivery (messages are sent from and reply to info@indianheritager.com)
ENABLE_BOOK_DONATION_EMAILS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Public order return URLs (API callback verifies payment directly with Zoho)
PUBLIC_API_URL=https://heritager-backend.onrender.com
SHOP_URL=https://books.indianheritager.org
UNPAID_ORDER_EXPIRY_MINUTES=60

# Zoho Payments
ENABLE_ZOHO_PAYMENTS=false
# Create a server-based app at https://api-console.zoho.in with Zoho Payments scopes
# (ZohoPay.payments.CREATE,ZohoPay.payments.READ) and generate an offline OAuth refresh
# token. account_id is your Zoho Payments business account id.
ZOHO_PAYMENTS_ACCOUNT_ID=
ZOHO_PAYMENTS_CLIENT_ID=
ZOHO_PAYMENTS_CLIENT_SECRET=
ZOHO_PAYMENTS_REFRESH_TOKEN=
ZOHO_PAYMENTS_API_DOMAIN=https://payments.zoho.in
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
# Where Zoho should redirect the shopper back to after paying
ZOHO_PAYMENTS_REDIRECT_URL=https://www.indianheritager.org/donation-success
# Donation return route for Zoho hosted checkout
ZOHO_PAYMENTS_DONATION_RETURN_URL=https://www.indianheritager.org/donation-success
